<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="badge_meilleur_partenaire_or" model="bd.partenaire.badge">
        <field name="name">Or</field>
        <field name="code">OR</field>
        <field name="icon">🥇</field>
        <field name="sequence">10</field>
        <field name="points_min">100</field>
        <field name="description">Partenaire exceptionnel : qualité, fiabilité et délais constamment excellents.</field>
    </record>

    <record id="badge_meilleur_partenaire_argent" model="bd.partenaire.badge">
        <field name="name">Argent</field>
        <field name="code">ARGENT</field>
        <field name="icon">🥈</field>
        <field name="sequence">20</field>
        <field name="points_min">70</field>
        <field name="description">Très bon partenaire, performances solides et régulières.</field>
    </record>

    <record id="badge_meilleur_partenaire_bronze" model="bd.partenaire.badge">
        <field name="name">Bronze</field>
        <field name="code">BRONZE</field>
        <field name="icon">🥉</field>
        <field name="sequence">30</field>
        <field name="points_min">40</field>
        <field name="description">Bon partenaire, performances correctes.</field>
    </record>

    <record id="badge_fournisseur_fiable" model="bd.partenaire.badge">
        <field name="name">Fiable</field>
        <field name="code">FIABLE</field>
        <field name="icon">✅</field>
        <field name="sequence">40</field>
        <field name="points_min">20</field>
        <field name="description">Respect constant des délais et de la qualité convenue.</field>
    </record>

    <record id="badge_nouveau_partenaire" model="bd.partenaire.badge">
        <field name="name">Nouveau</field>
        <field name="code">NOUVEAU</field>
        <field name="icon">🌱</field>
        <field name="sequence">50</field>
        <field name="points_min">0</field>
        <field name="description">Partenaire récemment intégré à la base de données.</field>
    </record>

</odoo>
