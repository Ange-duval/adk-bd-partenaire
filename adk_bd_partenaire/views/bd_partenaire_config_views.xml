<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================== Régime Fiscal ==================== -->
    <record id="view_bd_partenaire_regime_fiscal_list" model="ir.ui.view">
        <field name="name">bd.partenaire.regime.fiscal.list</field>
        <field name="model">bd.partenaire.regime.fiscal</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
            </list>
        </field>
    </record>

    <record id="view_bd_partenaire_regime_fiscal_form" model="ir.ui.view">
        <field name="name">bd.partenaire.regime.fiscal.form</field>
        <field name="model">bd.partenaire.regime.fiscal</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bd_partenaire_regime_fiscal" model="ir.actions.act_window">
        <field name="name">Régimes Fiscaux</field>
        <field name="res_model">bd.partenaire.regime.fiscal</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ==================== Forme Juridique ==================== -->
    <record id="view_bd_partenaire_legal_form_list" model="ir.ui.view">
        <field name="name">bd.partenaire.legal.form.list</field>
        <field name="model">bd.partenaire.legal.form</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="code"/>
            </list>
        </field>
    </record>

    <record id="action_bd_partenaire_legal_form" model="ir.actions.act_window">
        <field name="name">Formes Juridiques</field>
        <field name="res_model">bd.partenaire.legal.form</field>
        <field name="view_mode">list</field>
    </record>

    <!-- ==================== Domaine d'Activité ==================== -->
    <record id="view_bd_partenaire_activity_domain_list" model="ir.ui.view">
        <field name="name">bd.partenaire.activity.domain.list</field>
        <field name="model">bd.partenaire.activity.domain</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="code"/>
                <field name="parent_id"/>
            </list>
        </field>
    </record>

    <record id="view_bd_partenaire_activity_domain_form" model="ir.ui.view">
        <field name="name">bd.partenaire.activity.domain.form</field>
        <field name="model">bd.partenaire.activity.domain</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="parent_id"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Sous-domaines">
                            <field name="child_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="code"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bd_partenaire_activity_domain" model="ir.actions.act_window">
        <field name="name">Domaines d'Activité</field>
        <field name="res_model">bd.partenaire.activity.domain</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ==================== Catégorie Partenaire ==================== -->
    <record id="view_bd_partenaire_category_list" model="ir.ui.view">
        <field name="name">bd.partenaire.category.list</field>
        <field name="model">bd.partenaire.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="code"/>
            </list>
        </field>
    </record>

    <record id="action_bd_partenaire_category" model="ir.actions.act_window">
        <field name="name">Catégories de Partenaire</field>
        <field name="res_model">bd.partenaire.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ==================== Catégorie d'Article ==================== -->
    <record id="view_bd_partenaire_article_category_list" model="ir.ui.view">
        <field name="name">bd.partenaire.article.category.list</field>
        <field name="model">bd.partenaire.article.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="code"/>
            </list>
        </field>
    </record>

    <record id="action_bd_partenaire_article_category" model="ir.actions.act_window">
        <field name="name">Catégories d'Article / Type d'Achat</field>
        <field name="res_model">bd.partenaire.article.category</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
