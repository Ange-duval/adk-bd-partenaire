<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================== Formulaire ==================== -->
    <record id="view_bd_partenaire_form" model="ir.ui.view">
        <field name="name">bd.partenaire.form</field>
        <field name="model">bd.partenaire</field>
        <field name="arch" type="xml">
            <form string="Fiche Partenaire">
                <header>
                    <button name="action_set_status" type="object" string="Agréer" class="btn-primary"
                            context="{'status': 'agree'}" invisible="status == 'agree'"/>
                    <button name="action_set_status" type="object" string="Remettre en évaluation"
                            context="{'status': 'evaluation'}" invisible="status == 'evaluation'"/>
                    <button name="action_set_status" type="object" string="Suspendre"
                            context="{'status': 'suspendu'}" invisible="status == 'suspendu'"/>
                    <field name="status" widget="statusbar" statusbar_visible="evaluation,agree,suspendu"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_articles" type="object"
                                class="oe_stat_button" icon="fa-list-alt"
                                invisible="article_count == 0">
                            <field name="article_count" widget="statinfo" string="Articles"/>
                        </button>
                        <button name="action_view_badge_assignments" type="object"
                                class="oe_stat_button" icon="fa-trophy"
                                invisible="badge_count == 0">
                            <field name="badge_count" widget="statinfo" string="Badges"/>
                        </button>
                    </div>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h3><field name="ref"/></h3>
                        <label for="name" string="Nom / Raison Sociale"/>
                        <h1><field name="name" placeholder="Ex : Alpha Fournitures SARL"/></h1>
                        <field name="sigle" placeholder="Sigle / Nom Commercial"/>
                    </div>
                    <group>
                        <group>
                            <field name="partner_role" widget="radio" options="{'horizontal': true}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="domaine_activite_ids" widget="many2many_tags"
                                   options="{'no_create': False}"/>
                            <field name="categorie_ids" widget="many2many_tags"
                                   options="{'no_create': False}"/>
                        </group>
                        <group>
                            <field name="top_badge_id" readonly="1"/>
                            <field name="total_points" readonly="1"/>
                            <field name="badge_ids" widget="many2many_tags" readonly="1"/>
                            <button name="action_open_assign_badge_wizard" type="object"
                                    string="🏆 Attribuer un Badge" class="btn-secondary"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Identification Légale" name="legal">
                            <group>
                                <group>
                                    <field name="niu"/>
                                    <field name="rccm"/>
                                </group>
                                <group>
                                    <field name="regime_fiscal_id" options="{'no_create': False, 'no_open': False}"/>
                                    <field name="forme_juridique_id" options="{'no_create': False}"/>
                                </group>
                            </group>
                        </page>
                        <page string="Coordonnées" name="contact">
                            <group>
                                <group string="Adresse">
                                    <field name="street"/>
                                    <field name="street2"/>
                                    <field name="city"/>
                                    <field name="state_id"/>
                                    <field name="zip"/>
                                    <field name="country_id"/>
                                </group>
                                <group string="Contact">
                                    <field name="phone"/>
                                    <field name="mobile"/>
                                    <field name="email" widget="email"/>
                                    <field name="website" widget="url"/>
                                </group>
                            </group>
                            <group string="Interlocuteur Principal">
                                <group>
                                    <field name="contact_name"/>
                                    <field name="contact_function"/>
                                </group>
                                <group>
                                    <field name="contact_phone"/>
                                    <field name="contact_email" widget="email"/>
                                </group>
                            </group>
                            <group string="Informations Bancaires">
                                <field name="bank_name"/>
                                <field name="bank_account"/>
                            </group>
                        </page>
                        <page string="Interlocuteurs" name="contacts">
                            <field name="contact_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="function"/>
                                    <field name="phone"/>
                                    <field name="email"/>
                                </list>
                            </field>
                        </page>
                        <page string="Articles / Services Fournis" name="articles"
                              invisible="partner_role == 'client'">
                            <field name="article_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="reference"/>
                                    <field name="article_categorie_id"/>
                                    <field name="unite"/>
                                    <field name="prix_unitaire"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="delai_livraison_jours"/>
                                    <field name="disponibilite" widget="badge"
                                           decoration-success="disponibilite == 'disponible'"
                                           decoration-warning="disponibilite == 'sur_commande'"
                                           decoration-danger="disponibilite == 'rupture'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes Internes" name="notes">
                            <group>
                                <field name="date_registration"/>
                                <field name="registered_by"/>
                            </group>
                            <field name="note" placeholder="Notes internes sur ce partenaire..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ==================== Liste ==================== -->
    <record id="view_bd_partenaire_list" model="ir.ui.view">
        <field name="name">bd.partenaire.list</field>
        <field name="model">bd.partenaire</field>
        <field name="arch" type="xml">
            <list decoration-danger="status == 'suspendu'" decoration-muted="status == 'evaluation'">
                <field name="ref"/>
                <field name="name"/>
                <field name="status" widget="badge" decoration-success="status == 'agree'" decoration-danger="status == 'suspendu'" decoration-info="status == 'evaluation'"/>
                <field name="sigle" optional="hide"/>
                <field name="niu" optional="show"/>
                <field name="partner_role" optional="show"/>
                <field name="domaine_activite_ids" widget="many2many_tags" optional="show"/>
                <field name="categorie_ids" widget="many2many_tags" optional="hide"/>
                <field name="city" optional="hide"/>
                <field name="phone" optional="hide"/>
                <field name="total_points" optional="show" sum="Total"/>
            </list>
        </field>
    </record>

    <!-- ==================== Kanban ==================== -->
    <record id="view_bd_partenaire_kanban" model="ir.ui.view">
        <field name="name">bd.partenaire.kanban</field>
        <field name="model">bd.partenaire</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="sigle"/>
                <field name="partner_role"/>
                <field name="domaine_activite_ids"/>
                <field name="top_badge_id"/>
                <field name="total_points"/>
                <field name="image_1920"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click p-2">
                            <div class="d-flex align-items-center">
                                <img alt="Logo" t-att-src="'/web/image?model=bd.partenaire&amp;id=' + record.id.raw_value + '&amp;field=image_1920'"
                                     class="o_kanban_image rounded-circle me-2"
                                     style="width:40px;height:40px;object-fit:cover;"/>
                                <div class="flex-grow-1">
                                    <strong><field name="name"/></strong> <span class="text-muted">· <field name="ref"/></span>
                                    <div class="text-muted"><field name="sigle"/></div>
                                </div>
                                <span class="badge rounded-pill text-bg-warning">
                                    <field name="total_points"/> pts
                                </span>
                            </div>
                            <div class="mt-1">
                                <field name="domaine_activite_ids" widget="many2many_tags"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ==================== Recherche ==================== -->
    <record id="view_bd_partenaire_search" model="ir.ui.view">
        <field name="name">bd.partenaire.search</field>
        <field name="model">bd.partenaire</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Nom ou référence" filter_domain="['|', '|', ('ref', 'ilike', self), ('name', 'ilike', self), ('sigle', 'ilike', self)]"/>
                <field name="niu"/>
                <filter string="Agréés" name="f_agree" domain="[('status', '=', 'agree')]"/>
                <filter string="En évaluation" name="f_eval" domain="[('status', '=', 'evaluation')]"/>
                <filter string="Suspendus" name="f_susp" domain="[('status', '=', 'suspendu')]"/>
                <field name="rccm"/>
                <field name="domaine_activite_ids"/>
                <field name="categorie_ids"/>
                <field name="forme_juridique_id"/>
                <field name="regime_fiscal_id"/>
                <filter string="Fournisseurs" name="filter_role_fournisseur"
                        domain="[('partner_role', 'in', ['fournisseur', 'les_deux'])]"/>
                <filter string="Clients" name="filter_role_client"
                        domain="[('partner_role', 'in', ['client', 'les_deux'])]"/>
                <separator/>
                <filter string="Archivés" name="filter_inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Regrouper par">
                    <filter string="Type de Partenaire" name="groupby_role"
                            context="{'group_by': 'partner_role'}"/>
                    <filter string="Régime Fiscal" name="groupby_regime"
                            context="{'group_by': 'regime_fiscal_id'}"/>
                    <filter string="Forme Juridique" name="groupby_forme"
                            context="{'group_by': 'forme_juridique_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ==================== Actions ==================== -->
    <record id="action_bd_partenaire_fournisseurs" model="ir.actions.act_window">
        <field name="name">Fournisseurs</field>
        <field name="res_model">bd.partenaire</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('partner_role', 'in', ['fournisseur', 'les_deux'])]</field>
        <field name="context">{'default_partner_role': 'fournisseur'}</field>
        <field name="search_view_id" ref="view_bd_partenaire_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Créez votre premier fournisseur</p>
            <p>Enregistrez ici les fournisseurs de l'entreprise avec toutes leurs informations.</p>
        </field>
    </record>

    <record id="action_bd_partenaire_clients" model="ir.actions.act_window">
        <field name="name">Clients</field>
        <field name="res_model">bd.partenaire</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('partner_role', 'in', ['client', 'les_deux'])]</field>
        <field name="context">{'default_partner_role': 'client'}</field>
        <field name="search_view_id" ref="view_bd_partenaire_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Créez votre premier client</p>
        </field>
    </record>

    <record id="action_bd_partenaire_all" model="ir.actions.act_window">
        <field name="name">Tous les Partenaires</field>
        <field name="res_model">bd.partenaire</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_bd_partenaire_search"/>
    </record>

</odoo>
