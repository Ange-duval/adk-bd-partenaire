<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================== Badge : configuration ==================== -->
    <record id="view_bd_partenaire_badge_list" model="ir.ui.view">
        <field name="name">bd.partenaire.badge.list</field>
        <field name="model">bd.partenaire.badge</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="icon"/>
                <field name="name"/>
                <field name="code"/>
                <field name="points_min"/>
            </list>
        </field>
    </record>

    <record id="view_bd_partenaire_badge_form" model="ir.ui.view">
        <field name="name">bd.partenaire.badge.form</field>
        <field name="model">bd.partenaire.badge</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="icon"/>
                        </group>
                        <group>
                            <field name="points_min"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Description / Critères">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bd_partenaire_badge" model="ir.actions.act_window">
        <field name="name">Badges &amp; Distinctions</field>
        <field name="res_model">bd.partenaire.badge</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ==================== Attributions de badges ==================== -->
    <record id="view_bd_partenaire_badge_assignment_list" model="ir.ui.view">
        <field name="name">bd.partenaire.badge.assignment.list</field>
        <field name="model">bd.partenaire.badge.assignment</field>
        <field name="arch" type="xml">
            <list decoration-muted="active == False">
                <field name="date_assignment"/>
                <field name="partenaire_id"/>
                <field name="badge_id"/>
                <field name="period_label"/>
                <field name="points" sum="Total"/>
                <field name="assigned_by"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_bd_partenaire_badge_assignment_form" model="ir.ui.view">
        <field name="name">bd.partenaire.badge.assignment.form</field>
        <field name="model">bd.partenaire.badge.assignment</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="partenaire_id"/>
                            <field name="badge_id"/>
                            <field name="date_assignment"/>
                        </group>
                        <group>
                            <field name="period_label"/>
                            <field name="points"/>
                            <field name="active"/>
                            <field name="assigned_by"/>
                        </group>
                    </group>
                    <group string="Motif">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bd_partenaire_badge_assignment_search" model="ir.ui.view">
        <field name="name">bd.partenaire.badge.assignment.search</field>
        <field name="model">bd.partenaire.badge.assignment</field>
        <field name="arch" type="xml">
            <search>
                <field name="partenaire_id"/>
                <field name="badge_id"/>
                <field name="period_label"/>
                <filter string="Actifs" name="filter_active" domain="[('active', '=', True)]"/>
                <group expand="0" string="Regrouper par">
                    <filter string="Partenaire" name="groupby_partenaire" context="{'group_by': 'partenaire_id'}"/>
                    <filter string="Badge" name="groupby_badge" context="{'group_by': 'badge_id'}"/>
                    <filter string="Période" name="groupby_period" context="{'group_by': 'period_label'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bd_partenaire_badge_assignment" model="ir.actions.act_window">
        <field name="name">Historique des Attributions</field>
        <field name="res_model">bd.partenaire.badge.assignment</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_active': 1}</field>
    </record>

    <!-- ==================== Wizard d'attribution ==================== -->
    <record id="view_bd_partenaire_badge_assign_wizard_form" model="ir.ui.view">
        <field name="name">bd.partenaire.badge.assign.wizard.form</field>
        <field name="model">bd.partenaire.badge.assign.wizard</field>
        <field name="arch" type="xml">
            <form string="Attribuer un Badge">
                <group>
                    <field name="partenaire_id" options="{'no_create': True}"/>
                    <field name="badge_id"/>
                    <field name="period_label" placeholder="Ex : T1 2026"/>
                    <field name="points"/>
                </group>
                <group string="Motif">
                    <field name="note" nolabel="1"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Attribuer"
                            class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
